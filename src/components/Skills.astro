---
import { skillCategories } from '../data/skills';
---

<section class="py-12 sm:py-16">
  <h2 class="text-sm sm:text-base mb-6 sm:mb-8" style="color: var(--text-tertiary);">
    <span style="color: var(--accent);">##</span> skills
  </h2>

  <div class="space-y-4 sm:space-y-5">
    {skillCategories.map((category) => (
      <div class="flex flex-col sm:flex-row sm:items-baseline gap-1 sm:gap-4">
        <span class="text-xs sm:text-sm shrink-0 w-32" style="color: var(--text-tertiary);">
          {category.name}
        </span>
        <div class="flex flex-wrap gap-2">
          {category.skills.map((skill) => (
            <span
              class="text-xs sm:text-sm px-2 py-0.5 rounded"
              style="color: var(--text-primary); background: var(--bg-secondary); border: 1px solid var(--border-color);"
            >
              {skill}
            </span>
          ))}
        </div>
      </div>
    ))}
  </div>
</section>
