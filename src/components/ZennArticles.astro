---
interface Article {
  title: string;
  link: string;
  pubDate: string;
}

const MAX_ITEMS = 3;
let articles: Article[] = [];

try {
  const response = await fetch('https://zenn.dev/orangekame/feed');
  const xml = await response.text();

  const itemRegex = /<item>([\s\S]*?)<\/item>/g;
  const titleRegex = /<title><!\[CDATA\[(.*?)\]\]><\/title>/;
  const linkRegex = /<link>(.*?)<\/link>/;
  const pubDateRegex = /<pubDate>(.*?)<\/pubDate>/;

  let match;
  while ((match = itemRegex.exec(xml)) !== null && articles.length < MAX_ITEMS) {
    const item = match[1];
    const title = item.match(titleRegex)?.[1] || '';
    const link = item.match(linkRegex)?.[1] || '';
    const pubDateStr = item.match(pubDateRegex)?.[1] || '';

    const date = new Date(pubDateStr);
    const pubDate = `${date.getFullYear()}.${String(date.getMonth() + 1).padStart(2, '0')}`;

    articles.push({ title, link, pubDate });
  }
} catch (e) {
  console.error('Failed to fetch Zenn articles:', e);
}
---

{articles.length > 0 && (
  <section class="py-12 sm:py-16">
    <h2 class="text-sm sm:text-base mb-6 sm:mb-8" style="color: var(--text-tertiary);">
      <span style="color: var(--accent);">##</span> zenn
    </h2>

    <div class="space-y-4 sm:space-y-5">
      {articles.map((article) => (
        <a
          href={article.link}
          target="_blank"
          rel="noopener noreferrer"
          class="block group"
        >
          <div class="flex flex-col sm:flex-row sm:justify-between sm:items-baseline gap-1 sm:gap-4">
            <div class="min-w-0">
              <h3 class="text-sm sm:text-base font-medium group-hover:opacity-60 transition-opacity line-clamp-2 sm:truncate" style="color: var(--text-primary);">
                {article.title}
              </h3>
            </div>
            <span class="text-xs sm:text-sm shrink-0 tabular-nums" style="color: var(--text-tertiary);">
              {article.pubDate}
            </span>
          </div>
        </a>
      ))}
    </div>

    <div class="mt-6">
      <a
        href="https://zenn.dev/orangekame"
        target="_blank"
        rel="noopener noreferrer"
        class="text-sm hover:opacity-60 transition-opacity"
        style="color: var(--accent);"
      >
        view all →
      </a>
    </div>
  </section>
)}
