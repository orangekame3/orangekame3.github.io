---
import { getCollection } from 'astro:content';

const allPosts = await getCollection('blog');
const posts = allPosts
  .filter((post) => !post.data.draft && post.data.lang === 'en')
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 5);

const hasJaVersion = (slug: string) => allPosts.some((p) => p.slug === `${slug}-ja`);

const formatDate = (date: Date) => {
  return date.toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'short',
    day: 'numeric',
  });
};
---

<section class="py-12 sm:py-16">
  <h2 class="text-sm sm:text-base mb-6 sm:mb-8" style="color: var(--text-tertiary);">
    <span style="color: var(--accent);">##</span> posts
  </h2>

  {posts.length === 0 ? (
    <p class="text-sm text-center" style="color: var(--text-tertiary);">
      No posts yet.
    </p>
  ) : (
    <div class="space-y-4 sm:space-y-5">
      {posts.map((post) => (
        <a href={`/blog/${post.slug}`} class="block group">
          <div class="flex flex-col sm:flex-row sm:justify-between sm:items-baseline gap-1 sm:gap-4">
            <div class="flex items-center gap-2 min-w-0">
              <h3 class="text-sm sm:text-base font-medium group-hover:opacity-60 transition-opacity truncate" style="color: var(--text-primary);">
                {post.data.title}
              </h3>
              {hasJaVersion(post.slug) && (
                <span class="text-xs px-1 py-0.5 rounded shrink-0" style="background-color: var(--bg-tertiary); color: var(--accent);">
                  en/ja
                </span>
              )}
            </div>
            <span class="text-xs sm:text-sm shrink-0 tabular-nums" style="color: var(--text-tertiary);">
              {formatDate(post.data.date)}
            </span>
          </div>
        </a>
      ))}
    </div>
  )}

  {posts.length > 0 && (
    <div class="mt-6 sm:mt-8">
      <a
        href="/blog"
        class="text-xs opacity-60 hover:opacity-100 transition-opacity"
        style="color: var(--text-primary);"
      >
        view all →
      </a>
    </div>
  )}
</section>
