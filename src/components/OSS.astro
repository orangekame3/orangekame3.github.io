---
import { projects } from '../data/projects';
---

<section class="py-12 sm:py-16">
  <h2 class="text-sm sm:text-base mb-6 sm:mb-8" style="color: var(--text-tertiary);">
    <span style="color: var(--accent);">##</span> projects
  </h2>

  <div class="grid grid-cols-1 sm:grid-cols-2 gap-5 sm:gap-x-10 sm:gap-y-6">
    {projects.map((project) => (
      <a
        href={project.link}
        target="_blank"
        rel="noopener noreferrer"
        class="block group"
      >
        <div class="flex items-baseline justify-between gap-3">
          <h3 class="text-sm sm:text-base font-medium group-hover:opacity-60 transition-opacity" style="color: var(--text-primary);">
            {project.title}
          </h3>
          {typeof project.stars === 'number' && (
            <span class="text-xs tabular-nums" style="color: var(--text-tertiary);">
              ★ {project.stars.toLocaleString()}
            </span>
          )}
        </div>
        <p class="text-xs sm:text-sm mt-0.5 sm:mt-1" style="color: var(--text-tertiary);">
          {project.description}
        </p>
      </a>
    ))}
  </div>
</section>
