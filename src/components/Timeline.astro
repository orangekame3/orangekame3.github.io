---
const careers = [
  {
    title: 'Osaka Univ. QIQB',
    role: 'Software Developer & Researcher',
    period: '2023 — Present',
  },
  {
    title: 'Future Corp.',
    role: 'Backend Engineer & Consultant',
    period: '2021 — 2023',
  },
  {
    title: 'Tokyo University of Science',
    role: 'M.S. Physics',
    period: '2019 — 2021',
  },
  {
    title: 'Tokyo University of Science',
    role: 'B.S. Physics',
    period: '2015 — 2019',
  },
];
---

<section class="py-16">
  <h2 class="text-sm uppercase tracking-widest text-center mb-12" style="color: var(--text-tertiary); letter-spacing: 0.15em;">
    Experience
  </h2>

  <div class="space-y-6">
    {careers.map((career) => (
      <div class="flex justify-between items-baseline gap-4">
        <div class="min-w-0">
          <h3 class="text-base font-medium truncate" style="color: var(--text-primary);">
            {career.title}
          </h3>
          <p class="text-sm mt-1" style="color: var(--text-tertiary);">
            {career.role}
          </p>
        </div>
        <span class="text-sm shrink-0 tabular-nums" style="color: var(--text-tertiary);">
          {career.period}
        </span>
      </div>
    ))}
  </div>
</section>
