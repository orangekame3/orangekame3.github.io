---
import SocialIcons from './SocialIcons.astro';
import { profile } from '../data/profile';

const titleText = profile.title.toLowerCase();
---

<section class="pt-12 sm:pt-20 md:pt-32 pb-6 sm:pb-8">
  <div class="flex flex-col items-center text-center">
    <!-- Avatar -->
    <div class="mb-8 sm:mb-10">
      <img
        src={profile.avatar}
        alt={`${profile.name} (${profile.nameJa})`}
        class="w-24 h-24 sm:w-28 sm:h-28 md:w-32 md:h-32 rounded-full object-cover grayscale hover:grayscale-0 transition-all duration-700"
        style="border: 1px solid var(--border-color);"
      />
    </div>

    <!-- Name -->
    <h1 class="text-xl sm:text-2xl md:text-3xl font-medium mb-4 sm:mb-5" style="color: var(--text-primary);">
      <span style="color: var(--accent);">~/</span>{profile.name.toLowerCase().replace(' ', '-')} <span style="color: var(--text-secondary); font-weight: 400;">({profile.nameJa})</span>
    </h1>

    <!-- Title with typing animation -->
    <p class="text-xs sm:text-sm mb-8 sm:mb-10" style="color: var(--text-tertiary);">
      <span style="color: var(--accent-secondary);">&gt;</span> <span id="typing-text" class="typing" data-text={titleText}></span><span class="cursor">_</span>
    </p>

    <!-- Bio -->
    <div class="max-w-sm sm:max-w-md md:max-w-lg space-y-3 sm:space-y-4 text-xs sm:text-sm leading-relaxed px-2 text-left" style="color: var(--text-secondary);">
      {profile.bio.map((paragraph) => (
        <p><span style="color: var(--accent);">#</span> {paragraph}</p>
      ))}
    </div>

    <!-- Social Icons -->
    <div class="mt-10 sm:mt-12">
      <SocialIcons />
    </div>
  </div>
</section>

<style>
  .cursor {
    animation: blink 1s step-end infinite;
  }

  @keyframes blink {
    0%, 100% { opacity: 1; }
    50% { opacity: 0; }
  }
</style>

<script>
  const typingElement = document.getElementById('typing-text');
  if (typingElement) {
    const text = typingElement.dataset.text || '';
    let index = 0;

    function type() {
      if (index < text.length) {
        typingElement.textContent += text.charAt(index);
        index++;
        setTimeout(type, 50);
      }
    }

    type();
  }
</script>
