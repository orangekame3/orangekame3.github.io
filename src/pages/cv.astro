---
import Layout from '../layouts/Layout.astro';
import { skillCategories } from '../data/skills';
import { publications } from '../data/publications';
import { talks } from '../data/talks';
import { service } from '../data/service';
import { careers } from '../data/career';
import { profile } from '../data/profile';
import { socials } from '../data/socials';
import { projects } from '../data/projects';

const education = careers.filter((c) => c.role.includes('B.S.') || c.role.includes('M.S.') || c.role.includes('Ph.D.'));
const experience = careers.filter((c) => !c.role.includes('B.S.') && !c.role.includes('M.S.') && !c.role.includes('Ph.D.'));

const invited = talks.filter((t) => t.type === 'invited').sort((a, b) => b.date.localeCompare(a.date));
const conference = talks.filter((t) => t.type === 'conference').sort((a, b) => b.date.localeCompare(a.date));
const poster = talks.filter((t) => t.type === 'poster').sort((a, b) => b.date.localeCompare(a.date));
const cvPublications = [...publications].sort((a, b) => {
  if (a.note === 'IEEE QCE') return -1;
  if (b.note === 'IEEE QCE') return 1;
  return b.year.localeCompare(a.year);
});
const cvProjects = projects.filter((p) =>
  ['OQTOPUS', 'oqtopus-cloud', 'device-gateway', 'qdash', 'qasmtools'].includes(p.title)
);
const cvSummary = profile.cvSummary.filter((line) => !line.startsWith('Languages:'));

const cvSocials = socials.filter((s) => ['email', 'linkedin', 'github'].includes(s.icon));
---

<Layout title="CV - Takafumi Miyanaga | 宮永 崇史">
  <div class="cv-page">
    <main class="cv-sheet cv-content">
      <header class="cv-header">
        <div>
          <p class="cv-kicker">Curriculum Vitae</p>
          <h1>Takafumi Miyanaga</h1>
          <p class="cv-title">Quantum Systems Engineer & Software Developer</p>
        </div>
        <button onclick="window.print()" class="cv-print-button print:hidden">
          Save as PDF
        </button>
      </header>

      <div class="cv-contact">
        {cvSocials.map((s) => (
          <a href={s.href}>{s.name}</a>
        ))}
      </div>

      <section class="cv-section cv-summary">
        <h2>Professional Summary</h2>
        <div class="cv-summary-list">
          {cvSummary.map((line) => (
            <p>{line}</p>
          ))}
        </div>
      </section>

      {profile.languages && profile.languages.length > 0 && (
        <section class="cv-section">
          <h2>Languages</h2>
          <ul class="cv-plain-list">
          {profile.languages.map((l) => (
            <li>{l}</li>
          ))}
          </ul>
        </section>
      )}

      <section class="cv-section">
        <h2>Experience</h2>
        <div class="cv-stack">
          {experience.map((exp) => (
            <article class="cv-entry">
              <div class="cv-entry-header">
                <div>
                  <h3>{exp.title}</h3>
                  <p>{exp.role}</p>
                </div>
                <span>{exp.period}</span>
              </div>
              {exp.description && (
                <ul class="cv-bullets">
                  {exp.description.map((item) => (
                    <li>{item}</li>
                  ))}
                </ul>
              )}
            </article>
          ))}
        </div>
      </section>

      <section class="cv-section">
        <h2>Skills</h2>
        <div class="cv-skill-list">
          {skillCategories.map((category) => (
            <div class="cv-skill-row">
              <span>{category.name}</span>
              <p>{category.skills.join(', ')}</p>
            </div>
          ))}
        </div>
      </section>

      <section class="cv-section">
        <h2>Selected Projects</h2>
        <ul class="cv-projects">
          {cvProjects.map((p) => (
            <li>
              <strong>{p.title}</strong>
              <span>{p.description}</span>
              <a href={p.link}>{p.link}</a>
            </li>
          ))}
        </ul>
      </section>

      <section class="cv-section">
        <h2>Education</h2>
        <div class="cv-stack compact">
          {education.map((edu) => (
            <article class="cv-entry cv-entry-line">
              <div>
                <h3>{edu.title}</h3>
                <p>{edu.role}</p>
              </div>
              <span>{edu.period}</span>
            </article>
          ))}
        </div>
      </section>

      <section class="cv-section">
        <h2>Publications</h2>
        <ul class="cv-publications">
          {cvPublications.map((pub) => (
            <li>
              <span>{pub.title}</span>
              <em>{pub.note}, {pub.year}</em>
            </li>
          ))}
        </ul>
      </section>

      {invited.length > 0 && (
        <section class="cv-section">
          <h2>Invited Talks</h2>
          <ul class="cv-publications">
            {invited.map((talk) => (
              <li>
                <span>{talk.title}</span>
                <em>{talk.event}, {talk.date}</em>
              </li>
            ))}
          </ul>
        </section>
      )}

      {conference.length > 0 && (
        <section class="cv-section">
          <h2>Conference Presentations</h2>
          <ul class="cv-publications">
            {conference.map((talk) => (
              <li>
                <span>{talk.title}</span>
                <em>{talk.event}, {talk.date}</em>
              </li>
            ))}
          </ul>
        </section>
      )}

      {poster.length > 0 && (
        <section class="cv-section">
          <h2>Poster Presentations</h2>
          <ul class="cv-publications">
            {poster.map((talk) => (
              <li>
                <span>{talk.title}</span>
                <em>{talk.event}, {talk.date}{talk.note ? ` (${talk.note})` : ''}</em>
              </li>
            ))}
          </ul>
        </section>
      )}

      {service.length > 0 && (
        <section class="cv-section">
          <h2>Service</h2>
          <ul class="cv-publications">
            {service.map((s) => (
              <li>
                <span>{s.role}</span>
                <em>{s.event}, {s.date}</em>
              </li>
            ))}
          </ul>
        </section>
      )}

      <div class="cv-back print:hidden">
        <a href="/">Back to home</a>
      </div>
    </main>
  </div>
</Layout>

<style>
  :global(body) {
    background: #f3f4f6 !important;
  }

  :global(.cv-page .reveal) {
    opacity: 1 !important;
    transform: none !important;
  }

  .cv-page {
    min-height: 100vh;
    padding: 32px 16px;
    background: #f3f4f6;
    color: #111827;
    font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    letter-spacing: 0;
    line-height: 1.5;
  }

  .cv-sheet {
    max-width: 880px;
    margin: 0 auto;
    padding: 56px 64px;
    background: #ffffff;
    border: 1px solid #e5e7eb;
    box-shadow: 0 16px 50px rgba(15, 23, 42, 0.08);
  }

  .cv-header {
    display: flex;
    justify-content: space-between;
    gap: 24px;
    align-items: flex-start;
    padding-bottom: 20px;
    border-bottom: 2px solid #111827;
  }

  .cv-kicker {
    margin: 0 0 8px;
    color: #6b7280;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  h1 {
    margin: 0;
    color: #111827;
    font-size: 34px;
    line-height: 1.1;
    font-weight: 750;
    letter-spacing: 0;
  }

  .cv-title {
    margin: 8px 0 0;
    color: #374151;
    font-size: 15px;
    font-weight: 600;
  }

  .cv-print-button {
    flex: 0 0 auto;
    padding: 8px 12px;
    border: 1px solid #111827;
    border-radius: 6px;
    background: #ffffff;
    color: #111827;
    font-size: 12px;
    font-weight: 650;
    line-height: 1;
  }

  .cv-contact {
    display: flex;
    flex-wrap: wrap;
    gap: 10px 18px;
    padding: 16px 0 26px;
    color: #2563eb;
    font-size: 12px;
    font-weight: 600;
  }

  .cv-contact a,
  .cv-projects a,
  .cv-back a {
    color: #2563eb;
    text-decoration: none;
  }

  .cv-section {
    padding-top: 20px;
    margin-top: 20px;
    border-top: 1px solid #d1d5db;
    break-inside: avoid;
  }

  .cv-summary {
    padding-top: 0;
    margin-top: 0;
    border-top: 0;
  }

  .cv-section h2 {
    margin: 0 0 12px;
    color: #111827;
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .cv-summary-list {
    display: grid;
    gap: 6px;
  }

  .cv-summary-list p,
  .cv-entry p,
  .cv-skill-row p,
  .cv-projects span,
  .cv-publications span,
  .cv-publications em,
  .cv-plain-list li {
    margin: 0;
    color: #374151;
    font-size: 13px;
  }

  .cv-stack {
    display: grid;
    gap: 18px;
  }

  .cv-stack.compact {
    gap: 8px;
  }

  .cv-entry-header,
  .cv-entry-line {
    display: flex;
    justify-content: space-between;
    gap: 24px;
    align-items: baseline;
  }

  .cv-entry h3,
  .cv-entry-line h3 {
    margin: 0;
    color: #111827;
    font-size: 14px;
    font-weight: 750;
    letter-spacing: 0;
  }

  .cv-entry-header span,
  .cv-entry-line > span {
    flex: 0 0 auto;
    color: #6b7280;
    font-size: 12px;
    font-weight: 650;
  }

  .cv-bullets {
    margin: 8px 0 0 18px;
    padding: 0;
    color: #374151;
  }

  .cv-bullets li {
    margin: 3px 0;
    padding-left: 2px;
    color: #374151;
    font-size: 12px;
    line-height: 1.45;
  }

  .cv-skill-list {
    display: grid;
    gap: 7px;
  }

  .cv-skill-row {
    display: grid;
    grid-template-columns: 168px 1fr;
    gap: 18px;
    align-items: baseline;
  }

  .cv-skill-row > span {
    color: #111827;
    font-size: 12px;
    font-weight: 750;
  }

  .cv-projects,
  .cv-publications,
  .cv-plain-list {
    display: grid;
    gap: 7px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .cv-projects li {
    display: grid;
    grid-template-columns: 130px 1fr;
    gap: 4px 16px;
    align-items: baseline;
  }

  .cv-projects strong {
    color: #111827;
    font-size: 13px;
    font-weight: 750;
  }

  .cv-projects a {
    grid-column: 2;
    font-size: 11px;
    overflow-wrap: anywhere;
  }

  .cv-publications li {
    display: grid;
    gap: 2px;
  }

  .cv-publications em {
    color: #6b7280;
    font-style: normal;
    font-size: 12px;
  }

  .cv-back {
    margin-top: 32px;
    padding-top: 18px;
    border-top: 1px solid #e5e7eb;
    font-size: 13px;
    font-weight: 650;
  }

  @media (max-width: 720px) {
    .cv-page {
      padding: 0;
    }

    .cv-sheet {
      padding: 32px 22px;
      border: 0;
      box-shadow: none;
    }

    .cv-header,
    .cv-entry-header,
    .cv-entry-line {
      flex-direction: column;
      gap: 8px;
    }

    .cv-skill-row,
    .cv-projects li {
      grid-template-columns: 1fr;
      gap: 2px;
    }

    .cv-projects a {
      grid-column: auto;
    }
  }

  @media print {
    @page {
      size: A4;
      margin: 12mm;
    }

    :global(body) {
      background: white !important;
      color: black !important;
    }

    .cv-page {
      padding: 0 !important;
      background: white !important;
      color: black !important;
      font-size: 11px;
    }

    .cv-content {
      padding: 0 !important;
      max-width: 100% !important;
    }

    .cv-sheet {
      width: 100%;
      max-width: none;
      margin: 0;
      padding: 0 !important;
      border: 0;
      box-shadow: none;
    }

    .cv-header {
      padding-bottom: 12px;
    }

    .cv-contact {
      padding: 10px 0 16px;
    }

    .cv-section {
      padding-top: 12px;
      margin-top: 12px;
    }

    h1 {
      font-size: 26px;
    }

    .cv-summary-list p,
    .cv-entry p,
    .cv-skill-row p,
    .cv-projects span,
    .cv-publications span,
    .cv-publications em,
    .cv-plain-list li {
      font-size: 10.5px;
    }

    .cv-bullets li {
      font-size: 9.5px;
      line-height: 1.25;
      margin: 1px 0;
    }

    .cv-stack {
      gap: 9px;
    }

    .cv-bullets {
      margin-top: 5px;
    }

    .cv-print-button,
    .cv-back {
      display: none !important;
    }
  }
</style>
