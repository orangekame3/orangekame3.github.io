---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ProfileCard from '../components/ProfileCard.astro';
import LatestPosts from '../components/LatestPosts.astro';
import Timeline from '../components/Timeline.astro';
import Publication from '../components/Publication.astro';
import Talks from '../components/Talks.astro';
import OSS from '../components/OSS.astro';
import Media from '../components/Media.astro';
import Press from '../components/Press.astro';
import Activities from '../components/Activities.astro';
import Service from '../components/Service.astro';
---

<Layout title="Takafumi Miyanaga">
  <Header />

  <main class="max-w-xl mx-auto px-4 sm:px-6">
    <ProfileCard />
    <LatestPosts />
    <Timeline />
    <Publication />
    <Talks />
    <Media />
    <Press />
    <Activities />
    <Service />
    <OSS />
  </main>

  <Footer />
</Layout>
