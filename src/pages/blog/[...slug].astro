---
import { type CollectionEntry, getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: post,
  }));
}

type Props = CollectionEntry<'blog'>;

const post = Astro.props;
const { Content } = await post.render();

const hasMultiLang = !!(post.data.title_ja && post.data.title_en);
const defaultTitle = post.data.title_en || post.data.title_ja || 'Untitled';
const defaultDesc = post.data.desc_en || post.data.desc_ja || '';
const ogImage = `/og/${post.slug}.png`;
const siteUrl = 'https://www.orangekame3.net';
const postUrl = `${siteUrl}/blog/${post.slug}`;
const xShareText = `blogged.\n---\n${defaultTitle}`;
const xShareUrl = `https://x.com/intent/tweet?text=${encodeURIComponent(xShareText)}&url=${encodeURIComponent(postUrl)}`;
const fbShareUrl = `https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(postUrl)}`;
const linkedinShareUrl = `https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(postUrl)}`;
const hatenaShareUrl = `https://b.hatena.ne.jp/entry/${postUrl}`;

const formatDate = (date: Date) => {
  return date.toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
  });
};
---

<Layout title={`${defaultTitle} - Takafumi Miyanaga`} description={defaultDesc} ogImage={ogImage}>
  <Header />

  <main class="max-w-xl mx-auto px-4 sm:px-6 py-12 sm:py-20">
    <!-- Back link -->
    <a
      href="/blog"
      class="inline-block text-xs sm:text-sm mb-8 sm:mb-12 opacity-60 hover:opacity-100 transition-opacity"
      style="color: var(--text-primary);"
    >
      ← back
    </a>

    <article>
      <!-- Header -->
      <header class="mb-8 sm:mb-12">
        <div class="flex items-center justify-between mb-2">
          <div class="flex flex-col sm:flex-row sm:items-center gap-1 sm:gap-3 text-xs sm:text-sm" style="color: var(--text-tertiary);">
            <time>
              {formatDate(post.data.date)}
            </time>
            {post.data.updatedAt && (
              <span class="flex items-center gap-1">
                <span class="hidden sm:inline">·</span>
                <span>Updated: {formatDate(post.data.updatedAt)}</span>
              </span>
            )}
          </div>
          {hasMultiLang && (
            <div class="flex items-center rounded overflow-hidden text-xs" style="background-color: var(--bg-tertiary);">
              <button
                id="lang-en"
                class="lang-btn px-2 py-1 transition-opacity"
                data-lang="en"
              >
                EN
              </button>
              <button
                id="lang-ja"
                class="lang-btn px-2 py-1 transition-opacity"
                data-lang="ja"
              >
                JA
              </button>
            </div>
          )}
        </div>
        <h1 class="text-2xl sm:text-3xl font-medium break-words" style="color: var(--text-primary);">
          {hasMultiLang ? (
            <>
              <span class="title-text" data-lang="en">{post.data.title_en}</span>
              <span class="title-text" data-lang="ja" style="display: none;">{post.data.title_ja}</span>
            </>
          ) : (
            defaultTitle
          )}
        </h1>
      </header>

      <!-- Content -->
      <div class="prose">
        <Content />
      </div>

      <!-- Share buttons -->
      <div class="mt-12 pt-8 border-t" style="border-color: var(--border-color);">
        <p class="text-xs mb-4" style="color: var(--text-tertiary);">Share this post</p>
        <div class="flex flex-wrap gap-2 sm:gap-3">
          <a
            href={xShareUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="share-btn flex items-center gap-1.5 sm:gap-2 px-3 sm:px-4 py-2 rounded text-xs transition-opacity hover:opacity-80"
            style="background-color: var(--bg-tertiary); color: var(--text-primary);"
          >
            <svg class="w-4 h-4 shrink-0" viewBox="0 0 24 24" fill="currentColor">
              <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
            </svg>
            <span class="hidden sm:inline">Post</span>
          </a>
          <a
            href={fbShareUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="share-btn flex items-center gap-1.5 sm:gap-2 px-3 sm:px-4 py-2 rounded text-xs transition-opacity hover:opacity-80"
            style="background-color: var(--bg-tertiary); color: var(--text-primary);"
          >
            <svg class="w-4 h-4 shrink-0" viewBox="0 0 24 24" fill="currentColor">
              <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
            </svg>
            <span class="hidden sm:inline">Share</span>
          </a>
          <a
            href={linkedinShareUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="share-btn flex items-center gap-1.5 sm:gap-2 px-3 sm:px-4 py-2 rounded text-xs transition-opacity hover:opacity-80"
            style="background-color: var(--bg-tertiary); color: var(--text-primary);"
          >
            <svg class="w-4 h-4 shrink-0" viewBox="0 0 24 24" fill="currentColor">
              <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
            </svg>
            <span class="hidden sm:inline">Share</span>
          </a>
          <a
            href={hatenaShareUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="share-btn flex items-center gap-1.5 sm:gap-2 px-3 sm:px-4 py-2 rounded text-xs transition-opacity hover:opacity-80"
            style="background-color: var(--bg-tertiary); color: var(--text-primary);"
          >
            <svg class="w-4 h-4 shrink-0" viewBox="0 0 24 24" fill="currentColor">
              <path d="M20.47 0C22.42 0 24 1.58 24 3.53v16.94c0 1.95-1.58 3.53-3.53 3.53H3.53C1.58 24 0 22.42 0 20.47V3.53C0 1.58 1.58 0 3.53 0h16.94zm-3.705 14.47c-.78 0-1.41.63-1.41 1.41s.63 1.414 1.41 1.414 1.41-.634 1.41-1.414-.63-1.41-1.41-1.41zm.015-8.91c-1.89 0-2.855.93-2.855 2.765V9.51h1.775V8.28c0-.7.405-1.12 1.095-1.12.72 0 1.065.42 1.065 1.08 0 .6-.21 1.04-.645 1.61-.48.63-.795 1.17-.795 2.02v.69h1.89v-.69c0-.6.21-1.01.645-1.59.465-.63.78-1.2.78-2.04 0-1.69-.99-2.68-2.955-2.68zM9.97 15.87H7.66V8.205H5.565V6.415h6.515v1.79H9.97v7.665z"/>
            </svg>
            <span class="hidden sm:inline">Bookmark</span>
          </a>
          <button
            id="copy-link"
            class="share-btn flex items-center gap-1.5 sm:gap-2 px-3 sm:px-4 py-2 rounded text-xs transition-opacity hover:opacity-80"
            style="background-color: var(--bg-tertiary); color: var(--text-primary);"
            data-url={postUrl}
          >
            <svg class="w-4 h-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/>
              <path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/>
            </svg>
            <span id="copy-text" class="hidden sm:inline">Copy</span>
          </button>
        </div>
      </div>
    </article>
  </main>

  <Footer />
</Layout>

<script>
  function initCopyButton() {
    const copyBtn = document.getElementById('copy-link');
    const copyText = document.getElementById('copy-text');

    if (copyBtn) {
      copyBtn.addEventListener('click', async () => {
        const url = copyBtn.getAttribute('data-url');
        if (url) {
          await navigator.clipboard.writeText(url);
          copyBtn.style.backgroundColor = 'var(--accent)';
          copyBtn.style.color = 'var(--bg-primary)';
          if (copyText) copyText.textContent = 'Copied!';
          setTimeout(() => {
            copyBtn.style.backgroundColor = 'var(--bg-tertiary)';
            copyBtn.style.color = 'var(--text-primary)';
            if (copyText) copyText.textContent = 'Copy';
          }, 2000);
        }
      });
    }
  }

  initCopyButton();
  document.addEventListener('astro:after-swap', initCopyButton);
</script>

{hasMultiLang && (
  <script>
    function initLangSwitcher() {
      const buttons = document.querySelectorAll('.lang-btn');
      const titles = document.querySelectorAll('.title-text');
      const prose = document.querySelector('.prose');

      const savedLang = localStorage.getItem('blog-lang') || 'en';
      setLang(savedLang);

      buttons.forEach(btn => {
        btn.addEventListener('click', () => {
          const lang = btn.getAttribute('data-lang');
          if (lang) {
            setLang(lang);
            localStorage.setItem('blog-lang', lang);
          }
        });
      });

      function setLang(lang: string) {
        // Update buttons
        buttons.forEach(btn => {
          const isActive = btn.getAttribute('data-lang') === lang;
          if (isActive) {
            btn.style.backgroundColor = 'var(--accent)';
            btn.style.color = 'var(--bg-primary)';
            btn.style.opacity = '1';
          } else {
            btn.style.backgroundColor = 'transparent';
            btn.style.color = 'var(--text-secondary)';
            btn.style.opacity = '0.4';
          }
        });

        // Update titles
        titles.forEach(title => {
          const titleEl = title as HTMLElement;
          titleEl.style.display = title.getAttribute('data-lang') === lang ? 'inline' : 'none';
        });

        // Update content sections
        if (prose) {
          const sections = prose.querySelectorAll('[data-lang]');
          if (sections.length > 0) {
            sections.forEach(section => {
              const sectionEl = section as HTMLElement;
              sectionEl.style.display = section.getAttribute('data-lang') === lang ? 'block' : 'none';
            });
          }
        }
      }
    }

    initLangSwitcher();
    document.addEventListener('astro:after-swap', initLangSwitcher);
  </script>
)}

<style is:global>
  .prose {
    color: var(--text-secondary);
    line-height: 1.8;
    font-size: 0.9375rem;
    word-break: break-word;
    overflow-wrap: break-word;
    max-width: 100%;
    overflow-x: hidden;
  }

  @media (min-width: 640px) {
    .prose {
      font-size: 1rem;
    }
  }

  .prose h2 {
    color: var(--text-primary);
    font-size: 1.125rem;
    font-weight: 500;
    margin-top: 2rem;
    margin-bottom: 0.75rem;
  }

  @media (min-width: 640px) {
    .prose h2 {
      font-size: 1.25rem;
      margin-top: 2.5rem;
      margin-bottom: 1rem;
    }
  }

  .prose h3 {
    color: var(--text-primary);
    font-size: 1rem;
    font-weight: 500;
    margin-top: 1.5rem;
    margin-bottom: 0.5rem;
  }

  @media (min-width: 640px) {
    .prose h3 {
      font-size: 1.1rem;
      margin-top: 2rem;
      margin-bottom: 0.75rem;
    }
  }

  .prose p:not(.github-card-desc) {
    margin-bottom: 1rem;
  }

  @media (min-width: 640px) {
    .prose p:not(.github-card-desc) {
      margin-bottom: 1.25rem;
    }
  }

  .prose a:not(.github-card) {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .prose a:not(.github-card):hover {
    color: var(--accent-secondary);
    opacity: 1;
  }

  .prose .github-card {
    text-decoration: none;
    display: block;
    max-width: 100%;
    width: 100%;
    box-sizing: border-box;
  }

  .prose ul, .prose ol {
    margin-bottom: 1rem;
    padding-left: 1.25rem;
  }

  @media (min-width: 640px) {
    .prose ul, .prose ol {
      margin-bottom: 1.25rem;
      padding-left: 1.5rem;
    }
  }

  .prose li {
    margin-bottom: 0.375rem;
  }

  @media (min-width: 640px) {
    .prose li {
      margin-bottom: 0.5rem;
    }
  }

  .prose ul li {
    list-style-type: disc;
  }

  .prose ol li {
    list-style-type: decimal;
  }

  .prose code {
    background-color: var(--bg-tertiary);
    padding: 0.15rem 0.35rem;
    border-radius: 0.25rem;
    font-size: 0.8125rem;
    font-family: ui-monospace, monospace;
  }

  @media (min-width: 640px) {
    .prose code {
      padding: 0.2rem 0.4rem;
      font-size: 0.875rem;
    }
  }

  .prose pre {
    background-color: var(--bg-secondary);
    border: 1px solid var(--border-color);
    border-radius: 0.5rem;
    padding: 0.75rem;
    overflow-x: auto;
    margin-bottom: 1rem;
    font-size: 0.8125rem;
    max-width: 100%;
  }

  @media (min-width: 640px) {
    .prose pre {
      padding: 1rem;
      margin-bottom: 1.25rem;
      font-size: 0.875rem;
    }
  }

  .prose pre code {
    background: none;
    padding: 0;
    font-size: inherit;
  }

  .prose blockquote {
    border-left: 2px solid var(--accent);
    padding-left: 0.75rem;
    margin-bottom: 1rem;
    color: var(--text-tertiary);
    font-style: italic;
  }

  @media (min-width: 640px) {
    .prose blockquote {
      padding-left: 1rem;
      margin-bottom: 1.25rem;
    }
  }

  .prose img {
    border-radius: 0.5rem;
    margin: 1rem 0;
  }

  @media (min-width: 640px) {
    .prose img {
      margin: 1.5rem 0;
    }
  }

  .prose hr {
    border: none;
    border-top: 1px solid var(--border-color);
    margin: 1.5rem 0;
  }

  @media (min-width: 640px) {
    .prose hr {
      margin: 2rem 0;
    }
  }
</style>
