---
import { type CollectionEntry, getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: post,
  }));
}

type Props = CollectionEntry<'blog'>;

const post = Astro.props;
const { Content } = await post.render();

const hasMultiLang = !!(post.data.title_ja && post.data.title_en);
const defaultTitle = post.data.title_en || post.data.title_ja || 'Untitled';

const formatDate = (date: Date) => {
  return date.toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
  });
};
---

<Layout title={`${defaultTitle} - Takafumi Miyanaga`}>
  <Header />

  <main class="max-w-xl mx-auto px-4 sm:px-6 py-12 sm:py-20">
    <!-- Back link -->
    <a
      href="/blog"
      class="inline-block text-xs sm:text-sm mb-8 sm:mb-12 opacity-60 hover:opacity-100 transition-opacity"
      style="color: var(--text-primary);"
    >
      ← back
    </a>

    <article>
      <!-- Header -->
      <header class="mb-8 sm:mb-12">
        <div class="flex items-center justify-between mb-2">
          <time class="text-xs sm:text-sm" style="color: var(--text-tertiary);">
            {formatDate(post.data.date)}
          </time>
          {hasMultiLang && (
            <div class="flex items-center rounded overflow-hidden text-xs" style="background-color: var(--bg-tertiary);">
              <button
                id="lang-en"
                class="lang-btn px-2 py-1 transition-opacity"
                data-lang="en"
              >
                EN
              </button>
              <button
                id="lang-ja"
                class="lang-btn px-2 py-1 transition-opacity"
                data-lang="ja"
              >
                JA
              </button>
            </div>
          )}
        </div>
        <h1 class="text-2xl sm:text-3xl font-medium" style="color: var(--text-primary);">
          {hasMultiLang ? (
            <>
              <span class="title-text" data-lang="en">{post.data.title_en}</span>
              <span class="title-text" data-lang="ja" style="display: none;">{post.data.title_ja}</span>
            </>
          ) : (
            defaultTitle
          )}
        </h1>
      </header>

      <!-- Content -->
      <div class="prose">
        <Content />
      </div>
    </article>
  </main>

  <Footer />
</Layout>

{hasMultiLang && (
  <script>
    function initLangSwitcher() {
      const buttons = document.querySelectorAll('.lang-btn');
      const titles = document.querySelectorAll('.title-text');
      const prose = document.querySelector('.prose');

      const savedLang = localStorage.getItem('blog-lang') || 'en';
      setLang(savedLang);

      buttons.forEach(btn => {
        btn.addEventListener('click', () => {
          const lang = btn.getAttribute('data-lang');
          if (lang) {
            setLang(lang);
            localStorage.setItem('blog-lang', lang);
          }
        });
      });

      function setLang(lang: string) {
        // Update buttons
        buttons.forEach(btn => {
          const isActive = btn.getAttribute('data-lang') === lang;
          if (isActive) {
            btn.style.backgroundColor = 'var(--accent)';
            btn.style.color = 'var(--bg-primary)';
            btn.style.opacity = '1';
          } else {
            btn.style.backgroundColor = 'transparent';
            btn.style.color = 'var(--text-secondary)';
            btn.style.opacity = '0.4';
          }
        });

        // Update titles
        titles.forEach(title => {
          const titleEl = title as HTMLElement;
          titleEl.style.display = title.getAttribute('data-lang') === lang ? 'inline' : 'none';
        });

        // Update content sections
        if (prose) {
          const sections = prose.querySelectorAll('[data-lang]');
          if (sections.length > 0) {
            sections.forEach(section => {
              const sectionEl = section as HTMLElement;
              sectionEl.style.display = section.getAttribute('data-lang') === lang ? 'block' : 'none';
            });
          }
        }
      }
    }

    initLangSwitcher();
    document.addEventListener('astro:after-swap', initLangSwitcher);
  </script>
)}

<style is:global>
  .prose {
    color: var(--text-secondary);
    line-height: 1.8;
    font-size: 0.9375rem;
  }

  @media (min-width: 640px) {
    .prose {
      font-size: 1rem;
    }
  }

  .prose h2 {
    color: var(--text-primary);
    font-size: 1.125rem;
    font-weight: 500;
    margin-top: 2rem;
    margin-bottom: 0.75rem;
  }

  @media (min-width: 640px) {
    .prose h2 {
      font-size: 1.25rem;
      margin-top: 2.5rem;
      margin-bottom: 1rem;
    }
  }

  .prose h3 {
    color: var(--text-primary);
    font-size: 1rem;
    font-weight: 500;
    margin-top: 1.5rem;
    margin-bottom: 0.5rem;
  }

  @media (min-width: 640px) {
    .prose h3 {
      font-size: 1.1rem;
      margin-top: 2rem;
      margin-bottom: 0.75rem;
    }
  }

  .prose p {
    margin-bottom: 1rem;
  }

  @media (min-width: 640px) {
    .prose p {
      margin-bottom: 1.25rem;
    }
  }

  .prose a {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .prose a:hover {
    color: var(--accent-secondary);
    opacity: 1;
  }

  .prose ul, .prose ol {
    margin-bottom: 1rem;
    padding-left: 1.25rem;
  }

  @media (min-width: 640px) {
    .prose ul, .prose ol {
      margin-bottom: 1.25rem;
      padding-left: 1.5rem;
    }
  }

  .prose li {
    margin-bottom: 0.375rem;
  }

  @media (min-width: 640px) {
    .prose li {
      margin-bottom: 0.5rem;
    }
  }

  .prose ul li {
    list-style-type: disc;
  }

  .prose ol li {
    list-style-type: decimal;
  }

  .prose code {
    background-color: var(--bg-tertiary);
    padding: 0.15rem 0.35rem;
    border-radius: 0.25rem;
    font-size: 0.8125rem;
    font-family: ui-monospace, monospace;
  }

  @media (min-width: 640px) {
    .prose code {
      padding: 0.2rem 0.4rem;
      font-size: 0.875rem;
    }
  }

  .prose pre {
    background-color: var(--bg-secondary);
    border: 1px solid var(--border-color);
    border-radius: 0.5rem;
    padding: 0.75rem;
    overflow-x: auto;
    margin-bottom: 1rem;
    font-size: 0.8125rem;
  }

  @media (min-width: 640px) {
    .prose pre {
      padding: 1rem;
      margin-bottom: 1.25rem;
      font-size: 0.875rem;
    }
  }

  .prose pre code {
    background: none;
    padding: 0;
    font-size: inherit;
  }

  .prose blockquote {
    border-left: 2px solid var(--accent);
    padding-left: 0.75rem;
    margin-bottom: 1rem;
    color: var(--text-tertiary);
    font-style: italic;
  }

  @media (min-width: 640px) {
    .prose blockquote {
      padding-left: 1rem;
      margin-bottom: 1.25rem;
    }
  }

  .prose img {
    border-radius: 0.5rem;
    margin: 1rem 0;
  }

  @media (min-width: 640px) {
    .prose img {
      margin: 1.5rem 0;
    }
  }

  .prose hr {
    border: none;
    border-top: 1px solid var(--border-color);
    margin: 1.5rem 0;
  }

  @media (min-width: 640px) {
    .prose hr {
      margin: 2rem 0;
    }
  }
</style>
