---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

const allPosts = await getCollection('blog');
const posts = allPosts
  .filter((post) => !post.data.draft && post.data.lang === 'en')
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const hasJaVersion = (slug: string) => allPosts.some((p) => p.slug === `${slug}-ja`);

const formatDate = (date: Date) => {
  return date.toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'short',
    day: 'numeric',
  });
};
---

<Layout title="Blog - Takafumi Miyanaga">
  <Header />

  <main class="max-w-xl mx-auto px-4 sm:px-6 py-12 sm:py-20">
    <h1 class="text-sm sm:text-base mb-10 sm:mb-16" style="color: var(--text-tertiary);">
      <span style="color: var(--accent);">##</span> blog
    </h1>

    {posts.length === 0 ? (
      <p class="text-center" style="color: var(--text-tertiary);">
        No posts yet.
      </p>
    ) : (
      <div class="space-y-6 sm:space-y-8">
        {posts.map((post) => (
          <a href={`/blog/${post.slug}`} class="block group">
            <article>
              <div class="flex items-center gap-2">
                <time class="text-xs sm:text-sm tabular-nums" style="color: var(--text-tertiary);">
                  {formatDate(post.data.date)}
                </time>
                {hasJaVersion(post.slug) && (
                  <span class="text-xs px-1.5 py-0.5 rounded" style="background-color: var(--bg-tertiary); color: var(--accent);">
                    en/ja
                  </span>
                )}
              </div>
              <h2 class="text-base sm:text-lg font-medium mt-1 group-hover:opacity-60 transition-opacity" style="color: var(--text-primary);">
                {post.data.title}
              </h2>
              <p class="text-xs sm:text-sm mt-1 sm:mt-2 line-clamp-2" style="color: var(--text-secondary);">
                {post.data.description}
              </p>
            </article>
          </a>
        ))}
      </div>
    )}
  </main>

  <Footer />
</Layout>
