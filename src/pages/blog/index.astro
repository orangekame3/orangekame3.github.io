---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

const allPosts = await getCollection('blog');
const posts = allPosts
  .filter((post) => !post.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const hasMultiLang = (data: { title_ja?: string; title_en?: string }): boolean => {
  return !!(data.title_ja && data.title_en);
};

const formatDate = (date: Date) => {
  return date.toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'short',
    day: 'numeric',
  });
};
---

<Layout title="Blog - Takafumi Miyanaga">
  <Header />

  <main class="max-w-xl mx-auto px-4 sm:px-6 py-12 sm:py-20">
    <div class="flex items-center justify-between mb-10 sm:mb-16">
      <h1 class="text-sm sm:text-base" style="color: var(--text-tertiary);">
        <span style="color: var(--accent);">##</span> blog
      </h1>
      <div class="flex items-center rounded overflow-hidden text-xs" style="background-color: var(--bg-tertiary);">
        <button class="lang-btn px-2 py-1 transition-opacity" data-lang="en">EN</button>
        <button class="lang-btn px-2 py-1 transition-opacity" data-lang="ja">JA</button>
      </div>
    </div>

    {posts.length === 0 ? (
      <p class="text-center" style="color: var(--text-tertiary);">
        No posts yet.
      </p>
    ) : (
      <div class="space-y-6 sm:space-y-8">
        {posts.map((post) => (
          <a href={`/blog/${post.slug}`} class="block group">
            <article>
              <div class="flex items-center gap-2">
                <time class="text-xs sm:text-sm tabular-nums" style="color: var(--text-tertiary);">
                  {formatDate(post.data.date)}
                </time>
                {hasMultiLang(post.data) && (
                  <span class="text-xs px-1.5 py-0.5 rounded" style="background-color: var(--bg-tertiary); color: var(--accent);">
                    en/ja
                  </span>
                )}
              </div>
              <h2 class="post-title text-base sm:text-lg font-medium mt-1 group-hover:opacity-60 transition-opacity break-words" style="color: var(--text-primary);">
                {hasMultiLang(post.data) ? (
                  <>
                    <span class="title-text" data-lang="en">{post.data.title_en}</span>
                    <span class="title-text" data-lang="ja" style="display: none;">{post.data.title_ja}</span>
                  </>
                ) : (
                  post.data.title_en || post.data.title_ja
                )}
              </h2>
              <p class="post-desc text-xs sm:text-sm mt-1 sm:mt-2 line-clamp-2" style="color: var(--text-secondary);">
                {hasMultiLang(post.data) ? (
                  <>
                    <span class="desc-text" data-lang="en">{post.data.desc_en}</span>
                    <span class="desc-text" data-lang="ja" style="display: none;">{post.data.desc_ja}</span>
                  </>
                ) : (
                  post.data.desc_en || post.data.desc_ja
                )}
              </p>
            </article>
          </a>
        ))}
      </div>
    )}
  </main>

  <Footer />
</Layout>

<script>
  function initLangSwitcher() {
    const buttons = document.querySelectorAll('.lang-btn');
    const titles = document.querySelectorAll('.title-text');
    const descs = document.querySelectorAll('.desc-text');

    const savedLang = localStorage.getItem('blog-lang') || 'en';
    setLang(savedLang);

    buttons.forEach(btn => {
      btn.addEventListener('click', () => {
        const lang = btn.getAttribute('data-lang');
        if (lang) {
          setLang(lang);
          localStorage.setItem('blog-lang', lang);
        }
      });
    });

    function setLang(lang: string) {
      buttons.forEach(btn => {
        const isActive = btn.getAttribute('data-lang') === lang;
        const btnEl = btn as HTMLElement;
        if (isActive) {
          btnEl.style.backgroundColor = 'var(--accent)';
          btnEl.style.color = 'var(--bg-primary)';
          btnEl.style.opacity = '1';
        } else {
          btnEl.style.backgroundColor = 'transparent';
          btnEl.style.color = 'var(--text-secondary)';
          btnEl.style.opacity = '0.4';
        }
      });

      titles.forEach(title => {
        const el = title as HTMLElement;
        el.style.display = title.getAttribute('data-lang') === lang ? 'inline' : 'none';
      });

      descs.forEach(desc => {
        const el = desc as HTMLElement;
        el.style.display = desc.getAttribute('data-lang') === lang ? 'inline' : 'none';
      });
    }
  }

  initLangSwitcher();
  document.addEventListener('astro:after-swap', initLangSwitcher);
</script>
