---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
}

const { title, description = 'Takafumi Miyanaga (宮永 崇史) - 大阪大学QIQB 量子コンピュータシステム開発者・研究者。OQTOPUSプロジェクト開発者。', ogImage } = Astro.props;
const siteUrl = 'https://orangekame3.dev';
const canonicalUrl = new URL(Astro.url.pathname, siteUrl).href;
const image = ogImage ? `${siteUrl}${ogImage}` : `${siteUrl}/og/index.png`;
const keywords = 'Takafumi Miyanaga, 宮永 崇史, 宮永崇史, OQTOPUS, 量子コンピュータ, quantum computing, quantum computer, 量子計算, 量子情報, quantum information, 大阪大学, Osaka University, QIQB, orangekame3, 超伝導量子ビット, superconducting qubit, クラウド量子コンピュータ, cloud quantum computing';

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Person",
  "name": "Takafumi Miyanaga",
  "alternateName": "宮永崇史",
  "url": siteUrl,
  "image": `${siteUrl}/orangekame3.jpg`,
  "jobTitle": "Specially Appointed Researcher",
  "worksFor": {
    "@type": "Organization",
    "name": "Osaka University QIQB"
  },
  "sameAs": [
    "https://github.com/orangekame3",
    "https://twitter.com/orangekame3",
    "https://zenn.dev/orangekame",
    "https://www.linkedin.com/in/takafumi-miyanaga-4476131a6"
  ],
  "knowsAbout": ["Quantum Computing", "OQTOPUS", "Go", "Python", "Open Source Software"]
};
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/jpeg" href="/orangekame3.jpg" />
    <link rel="canonical" href={canonicalUrl} />
    <meta name="generator" content={Astro.generator} />

    <!-- SEO -->
    <meta name="description" content={description} />
    <meta name="keywords" content={keywords} />
    <meta name="author" content="Takafumi Miyanaga (宮永 崇史)" />
    <meta name="google-site-verification" content="Z8pILx7d8nW8TM_Hf_xzytUBBPyNO9lgu-ImPPNbfFQ" />

    <!-- OGP -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content="Takafumi Miyanaga | 宮永 崇史" />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={image} />
    <meta property="og:locale" content="ja_JP" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@orangekame3" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />

    <!-- JSON-LD -->
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

    <title>{title}</title>

    <!-- JetBrains Mono Font -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
  </head>
  <body class="min-h-screen flex flex-col" style="background-color: var(--bg-primary); color: var(--text-primary);">
    <slot />
  </body>
</html>
